# 此文件仅为配置示例；程序不会自动读取工作目录的 .env。
# 请使用用户环境变量，或在程序界面保存到 Windows DPAPI 加密存储。

# 百炼：Qwen 3.7 Flash 校对与断句共用同一把 Key。
DASHSCOPE_API_KEY=

# 仅首次下载 Hugging Face 受限模型时需要；本地模型齐全后通常不需要。
HF_TOKEN=

# 可选：本地 Qwen3-ASR 模型目录。
# QWENASR_QWEN3_ASR_DIR=C:\path\to\Qwen3-ASR-1.7B

# 可选：断句模型与百炼 OpenAI 兼容端点。
GROUP_LLM_MODEL=qwen3.7-flash-2026-07-15
# GROUP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
